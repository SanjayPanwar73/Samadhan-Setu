# Copy this file to .env and adjust as needed.

# Default is SQLite so the project runs with zero setup.
# For Postgres: postgresql://user:password@localhost:5432/complaints_db
DATABASE_URL=sqlite:///./complaints.db

SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ESCALATION_CHECK_INTERVAL_MINUTES=10
DEFAULT_SLA_HOURS=72

# Comma-separated list of frontend origins allowed to call this API.
# Default already covers Vite (5173) and CRA (3000) dev servers.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
