# Local demo defaults to SQLite and generates an ephemeral signing key.
DATABASE_URL=sqlite:///./complaints.db
ENVIRONMENT=development
AUTO_CREATE_SCHEMA=true

# Backend-only initial admin provisioning. Never expose these in the frontend.
# In production, both values are required when running `python -m scripts.seed`.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
SEED_DEMO_ACCOUNTS=true

# Set a random value of at least 32 characters for production.
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ESCALATION_CHECK_INTERVAL_MINUTES=10
ESCALATION_REPEAT_HOURS=24
DEFAULT_SLA_HOURS=72

# Comma-separated browser origins. Localhost origins are allowed in development.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
